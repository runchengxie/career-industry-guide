---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="页面不存在" description="这个地址没有对应的研究页面。">
  <h1>这个页面不存在</h1>
  <p>没有找到对应的行业、岗位或方法说明。本站不会用示例数据填补缺失页面。</p>
  <p>
    <a href={withBase(base, "")}>回到首页</a>
    ·
    <a href={withBase(base, "methods/")}>查看来源与方法</a>
  </p>
</BaseLayout>

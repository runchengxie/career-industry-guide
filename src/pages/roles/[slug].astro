---
import Base from "../../layouts/Base.astro";
import { verificationLabel } from "../../lib/labels.ts";
import { loadDataset } from "../../lib/load.ts";

export function getStaticPaths() {
  const data = loadDataset();
  return data.roles.map((role) => ({
    params: { slug: role.slug },
    props: { roleId: role.id },
  }));
}

const data = loadDataset();
const role = data.roles.find((item) => item.id === Astro.props.roleId);
if (!role) throw new Error("缺少岗位");
const industries = data.industries.filter((industry) => role.industryIds.includes(industry.id));
const siblings = data.roles.filter((item) => item.id !== role.id && item.direction === role.direction);
const sources = data.sources.filter((source) => role.sourceIds.includes(source.id));
const base = import.meta.env.BASE_URL;
---

<Base title={role.name} description={`${role.name}的工作线索、准备材料和核验状态。`}>
  <p class="links">
    {industries.map((industry) => (
      <a href={`${base}industries/${industry.slug}/`}>{industry.name}</a>
    ))}
  </p>
  <h1>{role.name}</h1>
  <p>
    <span class="tag">{verificationLabel[role.verification]}</span>
    {role.humanitiesFit === "adjacent" ? <span class="tag">相邻而非对口</span> : <span class="tag">文科相关入口</span>}
  </p>
  <p>{data.meta.verificationLimit}</p>
  <aside class="evidence-note" aria-label="岗位证据边界">
    <strong>这是一条研究线索，不是一则招聘</strong>
    <p>{role.limits}</p>
  </aside>
  <nav class="editorial-actions role-path" aria-label="岗位探索路径">
    <a href="#work">了解工作线索</a>
    <a href="#prepare">动手做个练习</a>
    <a href="#verification">确认还缺什么</a>
    <a href="#role-sources">追溯来源</a>
  </nav>

  <section class="section" id="work">
    <h2>材料能告诉我们什么</h2>
    <p>{role.summary}</p>
    <p>{role.dailyWork}</p>
  </section>
  <section class="section" id="prepare">
    <h2>用一个小作品试一试</h2>
    <ul class="plain practice-list">
      {role.preparation.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <p>这些是练习，不是已核验的雇主要求。</p>
  </section>
  <section class="section">
    <h2>出现在哪些样本</h2>
    <ul>
      {industries.map((industry) => (
        <li>
          <a href={`${base}industries/${industry.slug}/`}>{industry.name}</a>
        </li>
      ))}
    </ul>
  </section>
  <section class="section" id="verification">
    <h2>核验状态与限制</h2>
    {role.materialNature ? <p>材料性质：{role.materialNature}</p> : null}
    <p>{role.limits}</p>
    {role.employer ? <p>材料中的雇主：{role.employer}</p> : null}
    {role.postingTitle ? <p>材料中的标题：{role.postingTitle}</p> : null}
    {role.postingUrl ? (
      <p>
        <a href={role.postingUrl}>转载或年报材料链接，不是在招活页</a>
        {role.verifiedOn ? (
          <span>，核验日期 {role.verifiedOn}</span>
        ) : (
          <span>。本站没有把它核对成雇主官网正在发布的职位。</span>
        )}
      </p>
    ) : (
      <p>没有可标成已核验职位的链接。</p>
    )}
  </section>
  <section class="section">
    <h2>同方向的其他岗位</h2>
    <ul>
      {siblings.length > 0 ? (
        siblings.map((item) => (
          <li>
            <a href={`${base}roles/${item.slug}/`}>{item.name}</a>
            <span class="tag">{verificationLabel[item.verification]}</span>
          </li>
        ))
      ) : (
        <li>这个方向目前只录入了这一个岗位。</li>
      )}
    </ul>
  </section>
  <section class="section" id="role-sources">
    <h2>来源</h2>
    <ul>
      {sources.map((source) => (
        <li>
          <a href={source.url}>
            {source.author}：{source.title}
          </a>
          <span class="scope">访问日期 {source.accessed}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

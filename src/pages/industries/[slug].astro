---
import Base from "../../layouts/Base.astro";
import ClaimList from "../../components/ClaimList.astro";
import MetricList from "../../components/MetricList.astro";
import Section from "../../components/Section.astro";
import SourceList from "../../components/SourceList.astro";
import { createCitations } from "../../lib/citations.ts";
import { verificationLabel } from "../../lib/labels.ts";
import { loadDataset } from "../../lib/load.ts";
import { claimBlocks } from "../../lib/support.ts";

export function getStaticPaths() {
  const data = loadDataset();
  return data.industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industryId: industry.id },
  }));
}

const data = loadDataset();
const industry = data.industries.find((item) => item.id === Astro.props.industryId);
if (!industry) throw new Error("缺少行业");
const citations = createCitations(data.sources);
const roles = data.roles.filter((role) => industry.roleIds.includes(role.id));
const metrics = data.metrics.filter((metric) => industry.metricIds.includes(metric.id));
const claims = claimBlocks(industry);

// 编号按页面呈现顺序登记：正文段落在前，右栏指标在后。
for (const claim of claims) for (const sourceId of claim.sourceIds) citations.number(sourceId);
for (const metric of metrics) for (const sourceId of metric.sourceIds) citations.number(sourceId);
const base = import.meta.env.BASE_URL;
const isSample = industry.id === "advertising";

const toc = [
  { id: "definition", title: "定义与口径" },
  { id: "demand", title: "需求证据" },
  { id: "roles", title: "适合岗位" },
  { id: "daily-work", title: "日常工作概况" },
  { id: "thresholds", title: "入口门槛" },
  { id: "portfolio", title: "可做的小作品" },
  { id: "geography", title: "地域与资历限制" },
  { id: "profit", title: "盈利与稳定性" },
  { id: "risks", title: "风险" },
  { id: "questions", title: "尚未证实的问题" },
  { id: "metrics", title: "已录入指标" },
  { id: "sources", title: "来源" },
];
---

<Base title={industry.name} description={`${industry.name}的定义、证据、岗位和缺口。`}>
  <p>
    <a href={base}>返回比较</a>
  </p>
  <h1>{industry.name}</h1>
  {isSample ? (
    <section class="sample-overview" aria-labelledby="overview-title">
      <p class="eyebrow">行业速读 · 研究摘要</p>
      <h2 id="overview-title">先了解业务，再看岗位线索</h2>
      <p class="lede">{industry.comparison.definition}</p>
      <div class="overview-columns">
        <div>
          <h3>有哪些工作线索</h3>
          <p>{industry.comparison.roles}</p>
          <a href="#roles">查看岗位方向 →</a>
        </div>
        <div>
          <h3>先别下的结论</h3>
          <p>{industry.comparison.demand}</p>
          <a href="#demand">追溯需求证据 →</a>
        </div>
        <div>
          <h3>还不知道什么</h3>
          <p>{industry.comparison.gaps}</p>
          <a href="#questions">查看待核实问题 →</a>
        </div>
      </div>
      <p class="field-note">以上是现有材料的导读，不是招聘结论。详细依据和口径见下方正文。</p>
      <nav class="editorial-actions" aria-label="阅读路径">
        <a href="#roles">了解岗位</a>
        <a href="#portfolio">尝试一个练习</a>
        <a href="#sources">核对来源</a>
      </nav>
    </section>
  ) : (
    <p>{data.meta.sampleNote}</p>
  )}

  <div class="layout">
    <div class="article">
      <Section id="definition" title="定义与口径">
        <ClaimList claims={industry.definition} citations={citations} />
      </Section>
      <Section id="demand" title="需求证据">
        <ClaimList claims={industry.demand} citations={citations} />
      </Section>
      <Section id="roles" title="适合岗位">
        <ul>
          {roles.map((role) => (
            <li>
              <a href={`${base}roles/${role.slug}/`}>{role.name}</a>
              <span class="tag">{verificationLabel[role.verification]}</span>
              {role.humanitiesFit === "adjacent" ? <span class="tag">相邻而非对口</span> : null}
            </li>
          ))}
        </ul>
        {industry.id === "elderly-care" ? (
          <p>护理、康复和医疗技术岗位如果出现在招聘材料里，只视为相邻工作，不列入上面的文科岗位。</p>
        ) : null}
      </Section>
      <Section id="daily-work" title="日常工作概况">
        <ClaimList claims={industry.dailyWork} citations={citations} />
      </Section>
      <Section id="thresholds" title="入口门槛">
        <ClaimList claims={industry.thresholds} citations={citations} />
      </Section>
      <Section id="portfolio" title="可做的小作品或技能准备">
        <ul class="plain">
          {industry.portfolio.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p>这些是练习方向，不是雇主公布的录用条件。</p>
      </Section>
      <Section id="geography" title="地域与资历限制">
        <ClaimList claims={industry.geographyLimits} citations={citations} />
      </Section>
      <Section id="profit" title="盈利与稳定性">
        <ClaimList claims={industry.profit} citations={citations} />
      </Section>
      <Section id="risks" title="风险">
        <ClaimList claims={industry.risks} citations={citations} />
      </Section>
      <Section id="questions" title="尚未证实的问题">
        <ul class="plain">
          {industry.openQuestions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </Section>
    </div>

    <aside class="rail">
      <details class="toc-wrap" open>
        <summary>本页内容</summary>
        <nav class="toc" aria-label="本页目录">
          <ol>
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.title}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
      <section class="rail-block" id="metrics" aria-labelledby="metrics-heading">
        <h2 id="metrics-heading">已录入指标</h2>
        <MetricList metrics={metrics} citations={citations} compact />
      </section>
    </aside>
  </div>

  <Section id="sources" title="来源">
    <p class="field-note">按上面第一次出现的顺序编号。每条都写明访问日期；没有可靠发布日期的会直接说明。</p>
    <SourceList entries={citations.referenced()} />
  </Section>

  <script>
    import { setupToc } from "../../scripts/toc.ts";
    setupToc(document);
  </script>
</Base>

---
import Base from "../layouts/Base.astro";
import ClaimList from "../components/ClaimList.astro";
import { loadDataset } from "../lib/load.ts";
import { createCitations } from "../lib/citations.ts";
import { allClaims, supportIndex, supportOf } from "../lib/support.ts";

const data = loadDataset();
const citations = createCitations(data.sources);

// 方法段落按 section 分组，顺序按第一次出现
const methodSections: { title: string; claims: typeof data.meta.method }[] = [];
for (const claim of data.meta.method) {
  const title = claim.section ?? "其他";
  const group = methodSections.find((item) => item.title === title);
  if (group) group.claims.push(claim);
  else methodSections.push({ title, claims: [claim] });
}
const supports = supportIndex(data);
const names = new Map<string, string>();
for (const metric of data.metrics) names.set(metric.id, metric.name);
for (const role of data.roles) names.set(role.id, role.name);
for (const industry of data.industries) names.set(industry.id, industry.name);
for (const claim of allClaims(data)) {
  const text = claim.text.trim();
  names.set(claim.id, text.length > 24 ? `${text.slice(0, 24)}…` : text);
}
---

<Base title="来源与方法" description="研究范围、口径、引用和未核实问题。">
  <h1>来源与方法</h1>
  <p>地理范围是{data.meta.geography}。研究版本日期是 {data.meta.researchVersion}（{data.meta.timezone}）。</p>
  {
    methodSections.map((group) => (
      <section class="section">
        <h2>{group.title}</h2>
        <ClaimList claims={group.claims} citations={citations} />
      </section>
    ))
  }

  <section class="section">
    <h2>当前未核实清单</h2>
    <ul class="plain">
      {data.meta.unverifiedItems.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="section">
    <h2>来源记录</h2>
    <ul>
      {
        data.sources.map((source) => (
          <li>
            <a href={source.url}>{source.author}：{source.title}</a>
            <span class="scope">
              {source.published ? `发布或公布日期 ${source.published}` : "页面没有可靠发布日期"}，访问日期 {source.accessed}
            </span>
            <span class="note">支持：{supportOf(supports, source).map((id) => names.get(id) ?? id).join("、")}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

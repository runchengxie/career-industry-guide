---
import Base from "../layouts/Base.astro";
import MetricList from "../components/MetricList.astro";
import Section from "../components/Section.astro";
import SourceList from "../components/SourceList.astro";
import { createCitations } from "../lib/citations.ts";
import { emptyFilterMessage, matchingRoles } from "../lib/filter.ts";
import { loadDataset } from "../lib/load.ts";

const data = loadDataset();
const citations = createCitations(data.sources);
const metrics = new Map(data.metrics.map((metric) => [metric.id, metric]));

// 编号按表格的呈现顺序登记（先“需求证据”行，再“盈利与稳定性”行），
// 这样上标编号与页末来源表不依赖组件的渲染时机。
for (const key of ["demand", "profit"] as const) {
  for (const industry of data.industries) {
    for (const metricId of industry.homeMetricIds[key]) {
      for (const sourceId of metrics.get(metricId)?.sourceIds ?? []) citations.number(sourceId);
    }
  }
}
const rolesByIndustry = new Map(
  data.industries.map((industry) => [industry.id, data.roles.filter((role) => role.industryIds.includes(industry.id))]),
);
---

<Base title={data.meta.title}>
  <h1>{data.meta.title}</h1>
  <p class="lede">{data.meta.sampleNote}</p>
  <p>比较只覆盖已经录入的样本和岗位。筛选不会补充名单之外的行业，也不给出综合评分。</p>

  <fieldset>
    <legend>按岗位方向筛选</legend>
    <div class="choices">
      {data.meta.directions.map((direction) => (
        <label>
          <input type="radio" name="direction" value={direction.id} checked={direction.id === "all"} />
          <span class="chip-name">{direction.label}</span>
          {direction.detail ? <span class="chip-detail">（{direction.detail}）</span> : null}
        </label>
      ))}
    </div>
    <p class="field-note">不运行脚本时，下面仍显示全部三个样本。选择某一方向后，只保留至少有一个对口岗位的行业。</p>
    <p class="field-note" data-status aria-live="polite"></p>
  </fieldset>

  <div data-empty class="empty" hidden aria-live="polite">
    <p>{emptyFilterMessage}</p>
    <button type="button" data-reset>
      恢复全部
    </button>
  </div>

  <table class="compare">
    <caption>三个研究样本的对照，不是排名</caption>
    <thead>
      <tr>
        <th scope="col">比较维度</th>
        {data.industries.map((industry) => {
          const roles = rolesByIndustry.get(industry.id) ?? [];
          const directions = [
            ...new Set(matchingRoles(data.roles, industry.id, "all").map((role) => role.direction)),
          ].join(" ");
          return (
            <th data-industry={industry.id} data-directions={directions} scope="col">
              <a href={`${import.meta.env.BASE_URL}industries/${industry.slug}/`}>{industry.name}</a>
            </th>
          );
        })}
      </tr>
    </thead>
    <tbody>
      {[
        ["definition", "行业定义"],
        ["demand", "需求证据"],
        ["roles", "适合的文科岗位"],
        ["entry", "入口与地域限制"],
        ["profit", "盈利与稳定性"],
        ["risks", "主要风险"],
        ["gaps", "证据缺口"],
      ].map(([key, label]) => (
        <tr>
          <th scope="row">{label}</th>
          {data.industries.map((industry) => {
            const roles = rolesByIndustry.get(industry.id) ?? [];
            const directions = [
              ...new Set(matchingRoles(data.roles, industry.id, "all").map((role) => role.direction)),
            ].join(" ");
            const demand = industry.homeMetricIds.demand.flatMap((id) => {
              const metric = metrics.get(id);
              return metric ? [metric] : [];
            });
            const profit = industry.homeMetricIds.profit.flatMap((id) => {
              const metric = metrics.get(id);
              return metric ? [metric] : [];
            });
            return (
              <td
                data-industry={industry.id}
                data-directions={directions}
                data-label={key === "definition" ? "" : industry.name}
              >
                {key === "definition" ? (
                  <>
                    <p>
                      <a href={`${import.meta.env.BASE_URL}industries/${industry.slug}/`}>{industry.name}</a>
                    </p>
                    <p>{industry.comparison.definition}</p>
                  </>
                ) : null}
                {key === "demand" ? (
                  <>
                    <p>{industry.comparison.demand}</p>
                    <MetricList metrics={demand} citations={citations} compact limit={4} />
                  </>
                ) : null}
                {key === "roles" ? (
                  <>
                    <p>{industry.comparison.roles}</p>
                    <ul>
                      {roles.map((role) => (
                        <li data-role-direction={role.direction}>
                          <a href={`${import.meta.env.BASE_URL}roles/${role.slug}/`}>{role.name}</a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : null}
                {key === "entry" ? industry.comparison.entry : null}
                {key === "profit" ? (
                  <>
                    <p>{industry.comparison.profit}</p>
                    <MetricList metrics={profit} citations={citations} compact limit={4} />
                  </>
                ) : null}
                {key === "risks" ? industry.comparison.risks : null}
                {key === "gaps" ? industry.comparison.gaps : null}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>

  <Section id="sources" title="来源">
    <p class="field-note">按上面第一次出现的顺序编号；口径与地理位置收在每个指标下的“口径与说明”里。</p>
    <SourceList entries={citations.referenced()} />
  </Section>
</Base>

<script>
  import { setupHomeFilter } from "../scripts/home-filter.ts";
  setupHomeFilter(document);
</script>

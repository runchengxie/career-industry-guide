---
import { formatMetric } from "../lib/format.ts";
import { natureLabel } from "../lib/labels.ts";
import type { Metric, Source } from "../lib/types.ts";

interface Props {
  metrics: Metric[];
  sources: Source[];
}

const { metrics, sources } = Astro.props;
---

<ul class="metrics">
  {
    metrics.map((metric) => {
      const linked = sources.filter((source) => metric.sourceIds.includes(source.id));
      const text = formatMetric(metric);
      return (
        <li id={metric.id}>
          <span class="metric-name">{metric.name}</span>
          {metric.availability === "value" ? <span>{text}</span> : <span class="missing">{text}</span>}
          {metric.availability === "value" ? <span class="tag">{natureLabel[metric.nature]}</span> : null}
          {metric.geography ? <span class="scope">地理范围：{metric.geography}</span> : null}
          {metric.scope ? <span class="scope">口径：{metric.scope}</span> : null}
          {metric.formula ? <span class="note">公式：{metric.formula}</span> : null}
          {metric.note ? <span class="note">{metric.note}</span> : null}
          {linked.map((source) => (
            <a href={source.url}>{source.author}：{source.title}{source.published ? `（${source.published}）` : ""}</a>
          ))}
        </li>
      );
    })
  }
</ul>

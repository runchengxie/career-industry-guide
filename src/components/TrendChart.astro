---
import { formatValue } from "../lib/format.ts";
import { chartGeometry, seriesSegments } from "../lib/trend.ts";

interface Point {
  value: number;
  year: number;
  label: string;
  decimals: number;
  group: boolean;
  id: string;
  sources: string;
  primary: boolean;
}

interface Props {
  label: string;
  unit: string | null;
  points: Point[];
  connect: boolean;
  reasons: string[];
}

const { label, unit, points, connect, reasons } = Astro.props;
const chart = chartGeometry(points);
// 连线只穿过每年标记为主来源的点，且不跨年补线
const segments = seriesSegments(chart.points, connect);
const summary = points
  .map(
    (point) =>
      `${point.label} ${formatValue(point.value, unit, point.decimals, point.group)}（${point.sources}）${point.primary ? "" : "，并列来源"}`,
  )
  .join("，");
const note = !connect
  ? `仅并列展示，不连线：${reasons.join("；")}。`
  : segments.length > 0
    ? "连线只穿过每年标记为主来源的点；缺年断线，并列来源不参与连线。"
    : "同组年份不连续，只画散点，不跨年补线。";
---

<figure class="trend">
  <figcaption>
    {label}（{unit}）
  </figcaption>
  <p class="field-note">{note}</p>
  <svg viewBox={`0 0 ${chart.width} ${chart.height}`} role="img" aria-label={`${label}，纵轴取数据区间：${summary}`}>
    {chart.ticks.map((tick) => (
      <>
        <line
          x1={chart.left}
          x2={chart.width - chart.right}
          y1={tick.y}
          y2={tick.y}
          stroke="var(--muted)"
          stroke-opacity="0.3"
        />
        <text x={chart.left - 8} y={tick.y + 4} text-anchor="end" class="point-label">
          {new Intl.NumberFormat("zh-CN", { maximumFractionDigits: 1 }).format(tick.value)}
        </text>
      </>
    ))}
    {segments.map((segment) => (
      <path
        d={`M${segment.a.x},${segment.a.y} L${segment.b.x},${segment.b.y}`}
        fill="none"
        stroke="var(--pine)"
        stroke-width="2"
      />
    ))}
    {chart.points.map((point, index) => (
      <circle
        cx={point.x}
        cy={point.y}
        r="4"
        fill={points[index].primary ? "var(--pine)" : "var(--card)"}
        stroke="var(--pine)"
        stroke-width="2"
      >
        <title>
            {points[index].label}：{formatValue(point.value, unit, points[index].decimals, points[index].group)}（
            {points[index].sources}）
          </title>
      </circle>
    ))}
    {chart.years.map((year) => (
      <text x={year.x} y={chart.height - 8} text-anchor="middle" class="point-label">
        {year.year}
      </text>
    ))}
  </svg>
  <ul class="trend-values">
    {points.map((point) => (
      <li>
        <span>
          {point.label}：{formatValue(point.value, unit, point.decimals, point.group)}
          {point.primary ? "" : "（并列来源，不参与连线）"}
        </span>{" "}
        <span class="scope">来源：{point.sources}</span>
      </li>
    ))}
  </ul>
</figure>

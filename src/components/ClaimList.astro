---
import CitationRefs from "./CitationRefs.astro";
import type { Citations } from "../lib/citations.ts";
import type { Claim } from "../lib/types.ts";

interface Props {
  claims: Claim[];
  citations: Citations;
}

const { claims, citations } = Astro.props;
const kindLabel = { evidence: "证据", judgment: "判断", gap: "缺口" };
---

<ul class="claims">
  {
    claims.map((claim) => (
      <li id={claim.id}>
        <span class="kind">{kindLabel[claim.kind]}</span>
        <p>
          {claim.text}
          <CitationRefs sourceIds={claim.sourceIds} citations={citations} />
        </p>
      </li>
    ))
  }
</ul>

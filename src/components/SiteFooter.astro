---
import { loadDataset } from "../lib/load.ts";

const meta = loadDataset().meta;
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="wrap">
    <p>
      研究版本日期 {meta.researchVersion}（{meta.timezone}）。{meta.publicationStatus}。{meta.disclaimer}
    </p>
    <p>{meta.verificationLimit}</p>
    <p class="links">
      <a href={base}>返回首页</a>
      <a href={`${base}methods/`}>来源与方法</a>
    </p>
  </div>
</footer>

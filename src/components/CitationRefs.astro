---
import type { Citations } from "../lib/citations.ts";

interface Props {
  sourceIds: string[];
  citations: Citations;
}

const { sourceIds, citations } = Astro.props;
const refs = sourceIds
  .map((id) => citations.ref(id))
  .filter((ref) => ref.number > 0);
---

{
  refs.length > 0 ? (
    <sup class="fn">
      {refs.map((ref) => (
        <a id={ref.first ? `ref-${ref.number}` : undefined} href={`#src-${ref.number}`} aria-label={`来源 ${ref.number}`}>
          {ref.number}
        </a>
      ))}
    </sup>
  ) : null
}

---
import type { Citations } from "../lib/citations.ts";

interface Props {
  sourceIds: string[];
  citations: Citations;
}

const { sourceIds, citations } = Astro.props;
const numbers = sourceIds.map((id) => citations.number(id)).filter((n) => n > 0);
---

{
  numbers.length > 0 ? (
    <sup class="fn">
      {numbers.map((n) => (
        <a href={`#src-${n}`} aria-label={`来源 ${n}`}>
          {n}
        </a>
      ))}
    </sup>
  ) : null
}

---
import { withBase } from "../lib/paths";

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { href: "", label: "首页" },
  { href: "industries/advertising/", label: "广告营销服务" },
  { href: "industries/elderly-care/", label: "养老服务" },
  { href: "industries/domestic-tourism/", label: "国内旅游服务" },
  { href: "methods/", label: "来源与方法" },
];

function current(href: string): boolean {
  const target = withBase(base, href);
  const path = Astro.url.pathname;
  return path === target || path === target.replace(/\/$/, "") || (href === "" && (path === base || path === base.replace(/\/$/, "")));
}
---

<header class="site-header">
  <div class="wrap">
    <p class="kicker">中国大陆 · 初步研究 · 对照而非排名</p>
    <p class="brand"><a href={withBase(base, "")}>{siteName}</a></p>
    <nav aria-label="页面">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={withBase(base, link.href)} aria-current={current(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

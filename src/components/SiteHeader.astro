---
import { loadDataset } from "../lib/load.ts";

const data = loadDataset();
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href={base}>{data.meta.title}</a>
    <a href={base}>比较</a>
    {
      data.industries.map((industry) => (
        <a href={`${base}industries/${industry.slug}/`}>{industry.name}</a>
      ))
    }
    <a href={`${base}methods/`}>来源与方法</a>
  </div>
</header>

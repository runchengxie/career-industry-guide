---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { loadDataset } from "../lib/load.ts";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "三个行业样本的比较研究，不是就业保证，也不是排名。" } = Astro.props;
const meta = loadDataset().meta;
const pageTitle = title === meta.title ? title : `${title} · ${meta.title}`;
---

<html lang={meta.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip" href="#content">跳到正文</a>
    <p class="banner">
      <span class="wrap">{meta.disclaimer}网站{meta.publicationStatus}。{meta.verificationLimit}</span>
    </p>
    <SiteHeader />
    <main id="content" class="wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

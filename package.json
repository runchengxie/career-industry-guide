{
  "name": "career-industry-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "check:data": "tsx scripts/check-data.ts",
    "check:dist": "tsx scripts/check-dist.ts",
    "prebuild": "tsx scripts/check-data.ts",
    "build": "astro build",
    "typecheck": "astro check && tsc --noEmit",
    "dev": "astro dev",
    "preview": "astro preview",
    "check:html": "html-validate dist",
    "verify": "npm test && npm run typecheck && npm run build && npm run check:dist && npm run check:html"
  },
  "dependencies": {
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "^3.7.5",
    "@types/node": "^26.6.6",
    "html-validate": "^9.7.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
